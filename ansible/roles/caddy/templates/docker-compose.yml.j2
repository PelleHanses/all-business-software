services:
  caddy:
    image: caddy:{{ caddy_image_version }}
    container_name: caddy
    restart: {{ caddy_restart_policy }}
    ports:
      - "{{ caddy_bind_address }}:80:80"
      - "{{ caddy_bind_address }}:443:443"
      - "{{ caddy_bind_address }}:443:443/udp"
    volumes:
      - {{ caddy_config_file }}:/etc/caddy/Caddyfile:ro
      - {{ caddy_sites_dir }}:/etc/caddy/sites:ro
      - caddy_data:/data
      - caddy_config:/config
{% if caddy_php_fpm_enabled | bool %}
    depends_on:
      - php-fpm
{% endif %}

{% if caddy_php_fpm_enabled | bool %}
  php-fpm:
    image: {{ caddy_php_fpm_image }}
    restart: {{ caddy_restart_policy }}
    volumes:
      - {{ caddy_php_root_dir }}:/srv
{% endif %}

volumes:
  caddy_data:
  caddy_config:
