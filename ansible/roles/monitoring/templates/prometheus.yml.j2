global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

{% if prometheus_node_exporter_targets | length > 0 %}
  - job_name: node
    static_configs:
      - targets:
{% for target in prometheus_node_exporter_targets %}
          - "{{ target }}"
{% endfor %}
{% endif %}
