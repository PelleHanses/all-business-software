server:
  http_listen_port: 12345

entrypoint:
  instance: all

prometheus:
  config:
    global:
      scrape_interval: 15s
    scrape_configs:
      - job_name: 'alloy'
        static_configs:
          - targets: ['localhost:12345']

loki:
  config:
    auth_enabled: false
    server:
      http_listen_port: 3100
    common:
      storage:
        filesystem:
          chunks_directory: /tmp/loki/chunks
          rules_directory: /tmp/loki/rules
      replication_factor: 1
      ring:
        instance_addr: 127.0.0.1
        kvstore:
          store: inmemory
    schema_config:
      configs:
        - from: 2020-10-24
          store: boltdb-shipper
          object_store: filesystem
          schema: v11
          index:
            prefix: index_
            period: 24h
    ruler:
      alertmanager_url: http://localhost:9093
    query_range:
      results_cache:
        cache:
          embedded:
            enabled: true
            max_size_mb: 100